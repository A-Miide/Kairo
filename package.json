{
  "name": "kairo",
  "version": "4.0.0",
  "description": "KAIRO — live scripture detection for church services (Tauri + Rust)",
  "scripts": {
    "server": "cargo run --release --manifest-path src-tauri/Cargo.toml -p kairo-server",
    "dev": "npx @tauri-apps/cli@latest dev",
    "build": "npx @tauri-apps/cli@latest build",
    "tauri": "npx @tauri-apps/cli@latest",
    "server:node": "node server/server.js"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2"
  }
}
